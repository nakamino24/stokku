# ──────────────────────────────────────
# Stokku Environment Variables — Zero-Cost Portfolio Deployment
# ──────────────────────────────────────
# Architecture: Web on Vercel Hobby (proxy) → API on Render Free → DB on Neon Free
# Browser → https://<vercel>/api/v1/* → (Vercel rewrite) → https://<render>/api/v1/* → Neon
# Direct browser → onrender.com is NOT the supported prod client architecture.
# Reverse proxy keeps refresh cookie first-party (Lax) and avoids third-party-cookie blocking.
# No paid service, no credit card, no automatic billing. Suspension on quota expiry is expected.
#
# Local dev: copy to .env at repo root (or configure per-app .env).
# Production: configure variables in Render (API) and Vercel (Web) dashboards separately.
# Never commit real secrets. Never expose server secrets via NEXT_PUBLIC_*.

# ─── Database (Neon Free PostgreSQL) ───────
# Neon pooled connection (suitable for Prisma on Render).
# Example: postgresql://user:password@ep-xxx-pooler.neon.tech/neondb?sslmode=require
# For local dev you may use a local Postgres or Neon pooled URL.
# Production MUST use `prisma migrate deploy` against Neon — never SQLite or dev.db.
DATABASE_URL="postgresql://user:password@ep-xxx-pooler.aws.neon.tech/neondb?sslmode=require"

# ─── Node / Runtime ────────────────────────
# Render injects PORT automatically; do NOT hardcode in production.
NODE_ENV="development"
PORT="3001"

# ─── JWT / Auth Secrets (Render API only) ──
# Generate each: openssl rand -base64 32
# Must be >=16 chars, never expose to frontend, rotate on compromise.
ACCESS_TOKEN_SECRET="change-me-to-a-random-string-at-least-16-chars"
REFRESH_TOKEN_SECRET="change-me-to-another-random-string-at-least-16-chars"

# ─── Refresh Session / Password Reset ──────
# Defaults are baked into apps/api/src/config/index.ts; override only if needed.
# REFRESH_SESSION_TTL_SECONDS="604800"   # 7 days
# PASSWORD_RESET_TTL_MINUTES="60"

# ─── CORS / Allowed Origins (Render API) ───
# Vercel proxies, but backend still enforces explicit origin.
# Production: set to EXACT Vercel production origin (no trailing slash), e.g.:
#   CORS_ORIGINS="https://stokku.vercel.app"
# or APP_URL="https://stokku.vercel.app" (fallback). Multiple origins comma-separated if preview needs access.
# Local dev: "http://localhost:3000,http://localhost:3002"
CORS_ORIGINS="http://localhost:3000,http://localhost:3002"

# ─── Public App URL (API config) ───────────
# Canonical frontend URL for email links, password reset, etc.
# Production: https://stokku.vercel.app
# Local: http://localhost:3000
APP_URL="http://localhost:3000"

# ─── Cookie Security (auto-configured) ─────
# Production: Secure=true, HttpOnly=true, SameSite=Lax, path=/api/v1/auth (first-party via Vercel proxy).
# Development: Secure=false, SameSite=Lax.
# Do not use SameSite=None — not needed with same-origin proxy.

# ─── Frontend → Backend Proxy (Vercel Web) ──
# Production (Vercel): server/build-only, NOT NEXT_PUBLIC_*.
#   API_ORIGIN="https://stokku-api.onrender.com"  # no trailing slash, server-only
# Next.js rewrites /api/:path* → ${API_ORIGIN}/api/:path*  and  /backend-health → ${API_ORIGIN}/health
# Local dev: leave API_ORIGIN empty to use http://localhost:3001 via rewrite.
API_ORIGIN=""

# ─── Optional browser override (dev/test only) ─
# Production does NOT require NEXT_PUBLIC_API_URL. Leave empty to use same-origin /api/v1.
# Only set for local direct-to-backend testing without proxy, e.g. http://localhost:3001
# NEXT_PUBLIC_API_URL=""

# ─── Rate Limiting (API) ───────────────────
RATE_LIMIT_MAX=100
# PASSWORD_RESET_RATE_LIMIT_MAX=5

# ─── Logging ───────────────────────────────
LOG_LEVEL="info"

# ─── Vercel (auto-injected — DO NOT SET) ──
# VERCEL="1"
# VERCEL_URL="stokku.vercel.app"
