{
  "name": "stokku-monorepo",
  "version": "0.1.0",
  "private": true,
  "description": "Stokku warehouse management system monorepo",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "packageManager": "pnpm@8.6.0",
  "scripts": {
    "postinstall": "pnpm --filter @stokku/database exec prisma generate",
    "build": "turbo run build",
    "vercel-build": "turbo run build --filter=@stokku/ui --filter=@stokku/web",
    "dev": "turbo run dev --parallel",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:e2e": "pnpm --filter @stokku/web test:e2e",
    "docs:check": "node scripts/check-doc-links.mjs",
    "clean": "turbo run clean",
    "format": "prettier --write \"**/*.{js,ts,jsx,tsx,md,css,scss,html,json}\"",
    "deploy": "bash scripts/deploy.sh",
    "deploy:staging": "bash scripts/deploy.sh staging",
    "migrate:deploy": "pnpm --filter @stokku/database exec prisma migrate deploy",
    "render-build": "pnpm --filter @stokku/database build && pnpm --filter @stokku/api build && pnpm migrate:deploy"
  },
  "devDependencies": {
    "next": "^16.3.5",
    "prettier": "^3.9.6",
    "turbo": "^2.10.12"
  },
  "engines": {
    "node": "22.x"
  },
  "dependencies": {
    "@stokku/database": "workspace:^"
  },
  "pnpm": {
    "overrides": {
