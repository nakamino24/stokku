generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum OrganizationRole {
  OWNER
  ADMIN
  INVENTORY_MANAGER
  WAREHOUSE_STAFF
  CASHIER
  VIEWER
}

enum SupplierStatus {
  ACTIVE
  INACTIVE
  BLACKLISTED
}

enum PurchaseOrderStatus {
  DRAFT
  PENDING_APPROVAL
  APPROVED
  SENT
  PARTIALLY_RECEIVED
  RECEIVED
  CANCELLED
}

enum SalesOrderStatus {
  DRAFT
  CONFIRMED
  ALLOCATED
  PICKING
  PICKED
  PACKED
  SHIPPED
  DELIVERED
  CLOSED
  CANCELLED
  RETURNED
}

enum StockMovementType {
  RECEIPT
  ISSUE
  ADJUSTMENT
  TRANSFER_OUT
  TRANSFER_IN
  ALLOCATION
  DEALLOCATION
  PICK
  PUTAWAY
  SHIPMENT
  RETURN
  REVERSAL
}

enum InventoryStatus {
  AVAILABLE
  HOLD
  QUARANTINE
  DAMAGED
}

enum InventoryAllocationStatus {
  ACTIVE
  RELEASED
  FULFILLED
}

enum GoodsReceiptStatus {
  POSTED
  REVERSED
}

enum AdjustmentReasonCode {
  DAMAGE
  SHRINKAGE
  COUNT_VARIANCE
  EXPIRED
  FOUND_STOCK
  DATA_CORRECTION
  QUALITY_REJECTION
  RETURN_ADJUSTMENT
  OTHER
}

enum DocumentType {
  PURCHASE_ORDER
  SALES_ORDER
  GOODS_RECEIPT
  STOCK_TRANSFER
  STOCK_ADJUSTMENT
}

enum ProductStatus {
  ACTIVE
  INACTIVE
  DISCONTINUED
}

model Organization {
  id        String   @id @default(uuid())
  name      String
  slug      String   @unique
  email     String?
  phone     String?
  address   String?
  city      String?
  country   String?
  currency  String   @default("USD")
  timezone  String   @default("UTC")
  logoUrl   String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  ownerId String? @unique
  owner   User?   @relation("organizationOwner", fields: [ownerId], references: [id])

  members        OrganizationMember[]
  categories     Category[]
  products       Product[]
  suppliers      Supplier[]
  customers      Customer[]
  warehouses     Warehouse[]
  stockLevels    StockLevel[]
  stockMovements StockMovement[]
  allocations    InventoryAllocation[]
  goodsReceipts  GoodsReceipt[]
  documentSequences DocumentSequence[]
  purchaseOrders PurchaseOrder[]
  salesOrders    SalesOrder[]
  users           User[]
  roles           Role[]
  auditLogs       AuditLog[]
}

model User {
  id                       String   @id @default(uuid())
  email                    String   @unique
  passwordHash             String?
  googleId                 String?  @unique
  name                     String
  avatarUrl                String?
  phone                    String?
  isActive                 Boolean  @default(true)
  emailVerified            Boolean  @default(false)
  emailVerificationToken   String?
  emailVerificationExpires DateTime?
  passwordResetToken       String?
  passwordResetExpires     DateTime?
  lastLoginAt              DateTime?
  createdAt                DateTime @default(now())
  updatedAt                DateTime @updatedAt

  organizationId String
  organization   Organization     @relation(fields: [organizationId], references: [id], map: "user_org_fkey")
  role           OrganizationRole @default(VIEWER)

  ownedOrganization Organization? @relation("organizationOwner")

  createdStockMovements StockMovement[] @relation("createdBy")
  createdInventoryAllocations InventoryAllocation[] @relation("allocationCreatedBy")
  receivedGoodsReceipts GoodsReceipt[] @relation("goodsReceiptReceivedBy")
  createdPurchaseOrders PurchaseOrder[] @relation("poCreatedBy")
  createdSalesOrders    SalesOrder[]    @relation("soCreatedBy")
  auditLogs             AuditLog[]
  organizationMembers   OrganizationMember[]
  refreshSessions       RefreshSession[]
  passwordResetTokens   PasswordResetToken[]

  @@index([organizationId])
  @@index([email])
}

model OrganizationMember {
  id             String           @id @default(uuid())
  organizationId String
  organization   Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  userId         String
  user           User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  role           OrganizationRole @default(VIEWER)
  roleId         String?
  assignedRole   Role?            @relation(fields: [roleId], references: [id])
  joinedAt       DateTime         @default(now())

  @@unique([organizationId, userId])
  @@index([userId])
  @@index([roleId])
}

model Role {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name           String
  slug           String
  description    String?
  isSystem       Boolean      @default(false)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  permissions RolePermission[]
  members     OrganizationMember[]

  @@unique([organizationId, slug])
  @@index([organizationId])
}

model RolePermission {
  id         String @id @default(uuid())
  roleId     String
  role       Role   @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission String

  @@unique([roleId, permission])
  @@index([roleId])
}

model Category {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  parentId       String?
  parent         Category?    @relation("CategoryHierarchy", fields: [parentId], references: [id])
  children       Category[]   @relation("CategoryHierarchy")
  name           String
  slug           String
  description    String?
  imageUrl       String?
  color          String?
  sortOrder      Int          @default(0)
  isActive       Boolean      @default(true)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  products Product[]

  @@unique([organizationId, slug])
  @@index([organizationId])
  @@index([parentId])
}

model Product {
  id             String        @id @default(uuid())
  organizationId String
  organization   Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  categoryId     String?
  category       Category?     @relation(fields: [categoryId], references: [id])
  name           String
  sku            String?
  barcode        String?
  description    String?
  unitPrice      Decimal       @default(0) @db.Decimal(18, 6)
  costPrice      Decimal       @default(0) @db.Decimal(18, 6)
  taxRate        Decimal       @default(0) @db.Decimal(9, 6)
  unit           String        @default("pcs")
  minStock       Decimal       @default(0) @db.Decimal(18, 6)
  maxStock       Decimal?      @db.Decimal(18, 6)
  imageUrl       String?
  weight         Decimal?      @db.Decimal(18, 6)
  weightUnit     String        @default("kg")
  isActive       Boolean       @default(true)
  status         ProductStatus @default(ACTIVE)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  variants    ProductVariant[]
  suppliers   ProductSupplier[]
  stockLevels StockLevel[]
  movements   StockMovement[]
  poItems     PurchaseOrderItem[]
  soItems     SalesOrderItem[]
  receiptLines GoodsReceiptLine[]

  @@unique([organizationId, sku])
  @@index([organizationId])
  @@index([categoryId])
  @@index([barcode])
}

model ProductVariant {
  id         String  @id @default(uuid())
  productId  String
  product    Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  name       String
  sku        String?
  barcode    String?
  options    String  @default("{}")
  unitPrice  Decimal @default(0) @db.Decimal(18, 6)
  costPrice  Decimal @default(0) @db.Decimal(18, 6)
  imageUrl   String?
  sortOrder  Int     @default(0)
  isActive   Boolean @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  stockLevels StockLevel[]
  movements   StockMovement[]
  poItems     PurchaseOrderItem[]
  soItems     SalesOrderItem[]
  receiptLines GoodsReceiptLine[]

  @@unique([sku, productId])
  @@index([productId])
  @@index([barcode])
}

model ProductSupplier {
  id           String   @id @default(uuid())
  productId    String
  product      Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  supplierId   String
  supplier     Supplier @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  supplierSku  String?
  leadTimeDays Int?
  moq          Decimal? @db.Decimal(18, 6)
  unitCost     Decimal? @db.Decimal(18, 6)
  isPreferred  Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([productId, supplierId])
  @@index([supplierId])
}

model Supplier {
  id             String         @id @default(uuid())
  organizationId String
  organization   Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name           String
  contactPerson  String?
  email          String?
  phone          String?
  address        String?
  city           String?
  country        String?
  taxId          String?
  paymentTerms   String?
  currency       String         @default("USD")
  notes          String?
  status         SupplierStatus @default(ACTIVE)
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  products       ProductSupplier[]
  purchaseOrders PurchaseOrder[]

  @@index([organizationId])
  @@index([name])
}

model Customer {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name           String
  email          String?
  phone          String?
  address        String?
  city           String?
  country        String?
  taxId          String?
  notes          String?
  creditLimit    Decimal?
  isActive       Boolean      @default(true)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  salesOrders SalesOrder[]

  @@index([organizationId])
  @@index([email])
}

model Warehouse {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name           String
  code           String
  description    String?
  address        String?
  city           String?
  country        String?
  capacity       Decimal?      @db.Decimal(18, 6)
  isActive       Boolean      @default(true)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  zones         WarehouseZone[]
  stockLevels   StockLevel[]
  movements     StockMovement[]
  fromMovements StockMovement[] @relation("fromWarehouse")
  toMovements   StockMovement[] @relation("toWarehouse")
  goodsReceipts GoodsReceipt[]

  @@unique([organizationId, code])
  @@index([organizationId])
}

model WarehouseZone {
  id          String    @id @default(uuid())
  warehouseId String
  warehouse   Warehouse @relation(fields: [warehouseId], references: [id], onDelete: Cascade)
  name        String
  code        String
  description String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  bins WarehouseBin[]

  @@unique([warehouseId, code])
  @@index([warehouseId])
}

model WarehouseBin {
  id          String        @id @default(uuid())
  zoneId      String
  zone        WarehouseZone @relation(fields: [zoneId], references: [id], onDelete: Cascade)
  code        String
  maxCapacity Decimal?      @db.Decimal(18, 6)
  description String?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  stockLevels StockLevel[]
  goodsReceipts GoodsReceipt[]

  @@unique([zoneId, code])
  @@index([zoneId])
}

model StockLevel {
  id             String          @id @default(uuid())
  organizationId String
  organization   Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  warehouseId    String
  warehouse      Warehouse       @relation(fields: [warehouseId], references: [id], onDelete: Cascade)
  binId          String?
  bin            WarehouseBin?   @relation(fields: [binId], references: [id])
  productId      String
  product        Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  variantId      String?
  variant        ProductVariant? @relation(fields: [variantId], references: [id])
  inventoryStatus InventoryStatus @default(AVAILABLE)
  lotNumber      String?
  serialNumber   String?
  onHand         Decimal         @default(0) @db.Decimal(18, 6)
  allocated      Decimal         @default(0) @db.Decimal(18, 6)
  hold           Decimal         @default(0) @db.Decimal(18, 6)
  available      Decimal         @default(0) @db.Decimal(18, 6)
  reorderPoint   Decimal?        @db.Decimal(18, 6)
  reorderQty     Decimal?        @db.Decimal(18, 6)
  version        Int             @default(0)
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  movements StockMovement[]
  allocations InventoryAllocation[]

  // Nullable identity parts are enforced with a PostgreSQL NULLS NOT DISTINCT
  // unique index in the migration. Prisma cannot express that index yet.
  @@index([organizationId, warehouseId, productId, variantId, binId, inventoryStatus])
  @@index([productId])
  @@index([variantId])
  @@index([warehouseId])
  @@index([organizationId])
  @@index([reorderPoint])
}

model StockMovement {
  id              String            @id @default(uuid())
  organizationId  String
  organization    Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  type            StockMovementType
  productId       String
  product         Product           @relation(fields: [productId], references: [id])
  variantId       String?
  variant         ProductVariant?   @relation(fields: [variantId], references: [id])
  warehouseId     String?
  warehouse       Warehouse?        @relation(fields: [warehouseId], references: [id])
  fromWarehouseId String?
  fromWarehouse   Warehouse?        @relation("fromWarehouse", fields: [fromWarehouseId], references: [id])
  toWarehouseId   String?
  toWarehouse     Warehouse?        @relation("toWarehouse", fields: [toWarehouseId], references: [id])
  stockLevelId    String?
  stockLevel      StockLevel?       @relation(fields: [stockLevelId], references: [id])
  quantity        Decimal           @db.Decimal(18, 6)
  onHandDelta     Decimal           @default(0) @db.Decimal(18, 6)
  allocatedDelta  Decimal           @default(0) @db.Decimal(18, 6)
  holdDelta       Decimal           @default(0) @db.Decimal(18, 6)
  beforeOnHand    Decimal           @default(0) @db.Decimal(18, 6)
  afterOnHand     Decimal           @default(0) @db.Decimal(18, 6)
  beforeAllocated Decimal           @default(0) @db.Decimal(18, 6)
  afterAllocated  Decimal           @default(0) @db.Decimal(18, 6)
  beforeHold      Decimal           @default(0) @db.Decimal(18, 6)
  afterHold       Decimal           @default(0) @db.Decimal(18, 6)
  beforeAvailable Decimal           @default(0) @db.Decimal(18, 6)
  afterAvailable  Decimal           @default(0) @db.Decimal(18, 6)
  unitPrice       Decimal?          @db.Decimal(18, 6)
  totalPrice      Decimal?          @db.Decimal(24, 6)
  sourceDocumentType String?
  sourceDocumentId String?
  reference       String?
  idempotencyKey  String
  correlationId   String?
  reasonCode      AdjustmentReasonCode?
  reason          String?
  note            String?
  reversalOfId    String?
  reversalOf      StockMovement?    @relation("movementReversal", fields: [reversalOfId], references: [id])
  reversals       StockMovement[]   @relation("movementReversal")
  createdById     String
  createdBy       User              @relation("createdBy", fields: [createdById], references: [id])
  createdAt       DateTime          @default(now())

  @@index([productId])
  @@index([variantId])
  @@index([warehouseId])
  @@index([organizationId])
  @@index([createdAt])
  @@index([type])
  @@index([sourceDocumentType, sourceDocumentId])
  @@index([correlationId])
  @@unique([organizationId, idempotencyKey])
}

model PurchaseOrder {
  id             String              @id @default(uuid())
  organizationId String
  organization   Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  poNumber       String
  supplierId     String
  supplier       Supplier            @relation(fields: [supplierId], references: [id])
  status         PurchaseOrderStatus @default(DRAFT)
  orderDate      DateTime            @default(now())
  expectedDate   DateTime?
  receivedDate   DateTime?
  subtotal       Decimal             @default(0) @db.Decimal(24, 6)
  taxAmount      Decimal             @default(0) @db.Decimal(24, 6)
  totalAmount    Decimal             @default(0) @db.Decimal(24, 6)
  notes          String?
  createdById    String
  createdBy      User                @relation("poCreatedBy", fields: [createdById], references: [id])
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt

  items PurchaseOrderItem[]
  goodsReceipts GoodsReceipt[]

  @@unique([organizationId, poNumber])
  @@index([organizationId])
  @@index([supplierId])
  @@index([status])
}

model PurchaseOrderItem {
  id              String          @id @default(uuid())
  purchaseOrderId String
  purchaseOrder   PurchaseOrder   @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  productId       String
  product         Product         @relation(fields: [productId], references: [id])
  variantId       String?
  variant         ProductVariant? @relation(fields: [variantId], references: [id])
  quantity        Decimal         @db.Decimal(18, 6)
  receivedQty     Decimal         @default(0) @db.Decimal(18, 6)
  unitPrice       Decimal         @default(0) @db.Decimal(18, 6)
  totalPrice      Decimal         @default(0) @db.Decimal(24, 6)
  createdAt       DateTime        @default(now())

  @@index([purchaseOrderId])
  @@index([productId])

  receiptLines GoodsReceiptLine[]
}

model SalesOrder {
  id             String           @id @default(uuid())
  organizationId String
  organization   Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  soNumber       String
  customerId     String
  customer       Customer         @relation(fields: [customerId], references: [id])
  status         SalesOrderStatus @default(DRAFT)
  orderDate      DateTime         @default(now())
  subtotal       Decimal          @default(0) @db.Decimal(24, 6)
  taxAmount      Decimal          @default(0) @db.Decimal(24, 6)
  totalAmount    Decimal          @default(0) @db.Decimal(24, 6)
  notes          String?
  confirmedAt    DateTime?
  allocatedAt    DateTime?
  pickedAt       DateTime?
  packedAt       DateTime?
  shippedAt      DateTime?
  deliveredAt    DateTime?
  closedAt       DateTime?
  cancelledAt    DateTime?
  createdById    String
  createdBy      User             @relation("soCreatedBy", fields: [createdById], references: [id])
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  items SalesOrderItem[]
  allocations InventoryAllocation[]

  @@unique([organizationId, soNumber])
  @@index([organizationId])
  @@index([customerId])
  @@index([status])
}

model SalesOrderItem {
  id           String          @id @default(uuid())
  salesOrderId String
  salesOrder   SalesOrder      @relation(fields: [salesOrderId], references: [id], onDelete: Cascade)
  productId    String
  product      Product         @relation(fields: [productId], references: [id])
  variantId    String?
  variant      ProductVariant? @relation(fields: [variantId], references: [id])
  quantity     Decimal         @db.Decimal(18, 6)
  unitPrice    Decimal         @default(0) @db.Decimal(18, 6)
  totalPrice   Decimal         @default(0) @db.Decimal(24, 6)
  createdAt    DateTime        @default(now())

  @@index([salesOrderId])
  @@index([productId])

  allocations InventoryAllocation[]
}

model InventoryAllocation {
  id               String                    @id @default(uuid())
  organizationId   String
  organization     Organization              @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  salesOrderId     String
  salesOrder       SalesOrder                @relation(fields: [salesOrderId], references: [id], onDelete: Cascade)
  salesOrderItemId String
  salesOrderItem   SalesOrderItem            @relation(fields: [salesOrderItemId], references: [id], onDelete: Cascade)
  stockLevelId     String
  stockLevel       StockLevel                @relation(fields: [stockLevelId], references: [id])
  quantity         Decimal                   @db.Decimal(18, 6)
  status           InventoryAllocationStatus @default(ACTIVE)
  idempotencyKey   String
  createdById      String
  createdBy        User                      @relation("allocationCreatedBy", fields: [createdById], references: [id])
  createdAt        DateTime                  @default(now())
  releasedAt       DateTime?
  fulfilledAt      DateTime?

  @@unique([organizationId, idempotencyKey])
  @@unique([salesOrderItemId, stockLevelId])
  @@index([organizationId, status])
  @@index([salesOrderId])
  @@index([stockLevelId])
}

model GoodsReceipt {
  id                        String             @id @default(uuid())
  organizationId            String
  organization              Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  receiptNumber             String
  purchaseOrderId           String
  purchaseOrder             PurchaseOrder      @relation(fields: [purchaseOrderId], references: [id])
  warehouseId               String
  warehouse                 Warehouse          @relation(fields: [warehouseId], references: [id])
  binId                     String?
  bin                       WarehouseBin?       @relation(fields: [binId], references: [id])
  status                    GoodsReceiptStatus @default(POSTED)
  supplierDeliveryReference String?
  idempotencyKey            String
  receivedById              String
  receivedBy                User               @relation("goodsReceiptReceivedBy", fields: [receivedById], references: [id])
  receivedAt                DateTime           @default(now())
  postedAt                  DateTime           @default(now())
  reversedAt                DateTime?
  createdAt                 DateTime           @default(now())
  updatedAt                 DateTime           @updatedAt

  lines GoodsReceiptLine[]

  @@unique([organizationId, receiptNumber])
  @@unique([organizationId, idempotencyKey])
  @@index([purchaseOrderId])
  @@index([warehouseId])
}

model GoodsReceiptLine {
  id                  String            @id @default(uuid())
  goodsReceiptId      String
  goodsReceipt        GoodsReceipt      @relation(fields: [goodsReceiptId], references: [id], onDelete: Cascade)
  purchaseOrderItemId String
  purchaseOrderItem   PurchaseOrderItem @relation(fields: [purchaseOrderItemId], references: [id])
  productId           String
  product             Product           @relation(fields: [productId], references: [id])
  variantId           String?
  variant             ProductVariant?   @relation(fields: [variantId], references: [id])
  expectedQty         Decimal           @db.Decimal(18, 6)
  receivedQty         Decimal           @db.Decimal(18, 6)
  acceptedQty         Decimal           @db.Decimal(18, 6)
  rejectedQty         Decimal           @default(0) @db.Decimal(18, 6)
  createdAt           DateTime          @default(now())

  @@unique([goodsReceiptId, purchaseOrderItemId])
  @@index([purchaseOrderItemId])
  @@index([productId])
}

model DocumentSequence {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  documentType   DocumentType
  year           Int
  lastNumber     Int          @default(0)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@unique([organizationId, documentType, year])
  @@index([organizationId])
}

model AuditLog {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  userId         String
  user           User         @relation(fields: [userId], references: [id])
  action         String
  entityType     String
  entityId       String?
  oldValues      String?
  newValues      String?
  ipAddress      String?
  userAgent      String?
  createdAt      DateTime     @default(now())

  @@index([organizationId])
  @@index([entityType])
  @@index([createdAt])
  @@index([userId])
}

model RefreshSession {
  id            String   @id @default(uuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash     String   @unique
  familyId      String
  expiresAt     DateTime
  revokedAt     DateTime?
  revokedReason String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([userId])
  @@index([familyId])
  @@index([expiresAt])
}

model PasswordResetToken {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String   @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([expiresAt])
}
